+#!/usr/bin/env python3
+"""Rebuild the host-menu font from Noto Sans CJK KR 2.004 (OFL-1.1); requires fontTools."""
+import argparse
+import ast
+from pathlib import Path
+import re
+
+from fontTools import subset
+from fontTools.ttLib import TTFont
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def catalog_characters() -> set[int]:
+    source = (ROOT / 'runtime/ui_text_ko.inc').read_text(encoding='utf-8')
+    # The shared macro contains the native names of every language in the selector.
+    common = (ROOT / 'runtime/ui_text.c').read_text(encoding='utf-8')
+    source += common.split('#define LANG_NAMES')[1].split('// SWKBD:')[0]
+    strings = re.findall(r'"(?:[^"\\]|\\.)*"', source)
+    return {ord(c) for string in strings for c in ast.literal_eval(string)}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('source', type=Path, help='NotoSansCJK-Regular.ttc (KR face 1) or Korean OTF')
+    args = parser.parse_args()
+    font = TTFont(args.source, fontNumber=1 if args.source.suffix == '.ttc' else -1, recalcTimestamp=False)
+    chars = catalog_characters()
+    missing = chars - font.getBestCmap().keys()
+    if missing:
+        raise ValueError(f'Source font lacks codepoints: {sorted(missing)}')
+    options = subset.Options()
+    options.name_IDs = ['*']
+    options.name_legacy = True
+    options.name_languages = ['*']
+    options.layout_features = []
+    job = subset.Subsetter(options=options)
+    job.populate(unicodes=chars)
+    job.subset(font)
+    # A distinct family identifies this limited, modified font. Copyright/license records are retained.
+    for name in font['name'].names:
+        value = {1: 'Ocarina Menu KR', 2: 'Regular', 3: 'OcarinaMenuKR-2.004-UI',
+                 4: 'Ocarina Menu KR', 6: 'OcarinaMenuKR', 16: 'Ocarina Menu KR', 17: 'Regular'}.get(name.nameID)
+        if value is not None:
+            name.string = value.encode(name.getEncoding())
+    if 'CFF ' in font:
+        cff = font['CFF '].cff
+        cff.fontNames = ['OcarinaMenuKR']
+        cff.topDictIndex[0].FullName = 'Ocarina Menu KR'
+        cff.topDictIndex[0].FamilyName = 'Ocarina Menu KR'
+    output = ROOT / 'runtime/ui/fonts/OcarinaMenuKR.otf'
+    font.save(output)
+    print(f'{output.name}: {len(chars)} characters, {output.stat().st_size} bytes')
+
+
+if __name__ == '__main__':
+    main()
