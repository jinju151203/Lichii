diff --git a/tools/oot/check_korean_atlas.cpp b/tools/oot/check_korean_atlas.cpp
new file mode 100644
index 0000000..76d59cc
--- /dev/null
+++ b/tools/oot/check_korean_atlas.cpp
@@ -0,0 +1,43 @@
+// Uses the same glyph builder and stb renderer as the real menu; no GPU/game data required.
+#include <cstdio>
+#include <fstream>
+#include <iterator>
+#include <vector>
+#include "ui/catalog_glyphs.h"
+
+int main(int argc, char **argv) {
+    if (argc != 2) return 2;
+    std::ifstream input(argv[1], std::ios::binary);
+    std::vector<char> bytes((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+    if (bytes.size() < 100) return 3;
+    ImGui::CreateContext();
+    ImFontAtlas *atlas = ImGui::GetIO().Fonts;
+    for (float pixels : {26.0f, 52.0f}) {
+        atlas->Clear();
+        ImFontConfig base;
+        base.SizePixels = pixels;
+        ImFont *font = atlas->AddFontDefault(&base);
+        ImFontGlyphRangesBuilder builder;
+        menu_catalog_glyphs(builder, "ko");
+        ImVector<ImWchar> ranges;
+        builder.BuildRanges(&ranges);
+        ImFontConfig config;
+        config.MergeMode = true;
+        config.FontDataOwnedByAtlas = false;
+        if (!atlas->AddFontFromMemoryTTF(bytes.data(), (int)bytes.size(), pixels, &config, ranges.Data)) return 4;
+        if (!atlas->Build()) return 5;
+        int count = 0;
+        for (int i = 0; ranges[i]; i += 2)
+            for (unsigned cp = ranges[i]; cp <= ranges[i + 1]; ++cp) {
+                if (!font->FindGlyphNoFallback((ImWchar)cp)) {
+                    std::fprintf(stderr, "Missing U+%04X at %.0f px\n", cp, pixels);
+                    return 6;
+                }
+                ++count;
+            }
+        std::printf("%.0f px: %d glyphs, atlas %dx%d, no missing characters\n",
+                    pixels, count, atlas->TexWidth, atlas->TexHeight);
+        atlas->ClearInputData();
+    }
+    ImGui::DestroyContext();
+}
diff --git a/tools/oot/package_singlefile.py b/tools/oot/package_singlefile.py
new file mode 100644
index 0000000..b1f5a27
--- /dev/null
+++ b/tools/oot/package_singlefile.py
@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+"""Build an x64 Windows setup EXE embedding the prepared, game-free setup ZIP."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('zip', type=Path)
+    parser.add_argument('--cc', type=Path, required=True, help='x86_64-w64-mingw32-clang[.exe]')
+    parser.add_argument('--windres', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory() as temp:
+        folder = Path(temp)
+        script = folder / 'bootstrap.ps1'
+        source = (ROOT / 'instalador/bootstrap.ps1').read_text(encoding='utf-8-sig')
+        script.write_bytes(b'\xef\xbb\xbf' + source.replace('\n', '\r\n').encode('utf-8'))
+        manifest = folder / 'setup.manifest'
+        manifest.write_text('''<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
+<assemblyIdentity type="win32" name="OcarinaRecomp.KoreanSetup" version="0.2.1.1" processorArchitecture="amd64"/>
+<trustInfo xmlns="urn:schemas-microsoft-com:asm.v3"><security><requestedPrivileges><requestedExecutionLevel level="asInvoker" uiAccess="false"/></requestedPrivileges></security></trustInfo>
+<application xmlns="urn:schemas-microsoft-com:asm.v3"><windowsSettings><longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware></windowsSettings></application>
+</assembly>''')
+        rc = folder / 'setup.rc'
+        quoted = lambda p: '"' + str(p.resolve()).replace('\\', '/') + '"'
+        rc.write_text('101 RCDATA ' + quoted(args.zip) + '\n102 RCDATA ' + quoted(script) +
+                      '\n1 24 ' + quoted(manifest) + '''
+1 VERSIONINFO
+ FILEVERSION 0,2,1,1
+ PRODUCTVERSION 0,2,1,1
+ FILEOS 0x40004
+ FILETYPE 1
+BEGIN
+ BLOCK "StringFileInfo"
+ BEGIN
+  BLOCK "040904b0"
+  BEGIN
+   VALUE "FileDescription", "Ocarina Recomp Korean Native Build Setup\\0"
+   VALUE "FileVersion", "0.2.1-ko1\\0"
+   VALUE "ProductName", "Ocarina Recomp Korean Setup\\0"
+   VALUE "OriginalFilename", "Ocarina_Korean_Setup.exe\\0"
+  END
+ END
+ BLOCK "VarFileInfo"
+ BEGIN
+  VALUE "Translation", 0x409, 1200
+ END
+END
+''')
+        resource = folder / 'setup.res'
+        subprocess.run([str(args.windres), '-i', str(rc), '-o', str(resource), '-O', 'coff'], check=True)
+        subprocess.run([str(args.cc), '-std=c11', '-O2', '-Wall', '-Wextra', '-Werror', '-municode', '-mwindows',
+                        str(ROOT / 'instalador/singlefile.c'), str(resource), '-lole32', '-static', '-s',
+                        '-o', str(args.out)], check=True)
+    print(f'{args.out}: {args.out.stat().st_size:,} bytes')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/oot/set_korean.py b/tools/oot/set_korean.py
new file mode 100644
index 0000000..4eb0523
--- /dev/null
+++ b/tools/oot/set_korean.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Select game/menu Korean without resetting unrelated settings or touching game data."""
+from __future__ import annotations
+
+import argparse
+import os
+from pathlib import Path
+import re
+import tempfile
+
+
+def korean_config(data: bytes) -> bytes:
+    bom = b"\xef\xbb\xbf" if data.startswith(b"\xef\xbb\xbf") else b""
+    text = data[len(bom):].decode("utf-8")
+    newline = "\r\n" if "\r\n" in text else "\n"
+    seen: set[str] = set()
+    out: list[str] = []
+    # cfg.c accepts prefixed keys, any case, in any section; the last duplicate wins.
+    key_re = re.compile(r"^([ \t]*(?:TOTK_)?(LANG|MENU_LANG)[ \t]*=[ \t]*)([^\r\n]*)(\r?\n)?$", re.I)
+    for line in text.splitlines(keepends=True):
+        match = key_re.match(line)
+        if match:
+            seen.add(match[2].upper())
+            if match[3].strip().strip('"') != "ko":
+                line = match[1] + "ko" + (match[4] or "")
+        out.append(line)
+    result = "".join(out)
+    missing = [key for key in ("LANG", "MENU_LANG") if key not in seen]
+    if missing:
+        if result and not result.endswith("\n"):
+            result += newline
+        result += newline + "[language]" + newline
+        result += "".join(key.lower() + " = ko" + newline for key in missing)
+    return bom + result.encode("utf-8")
+
+
+def apply(path: Path) -> Path | None:
+    existed = path.exists()
+    original = path.read_bytes() if existed else b""
+    updated = korean_config(original)
+    if updated == original:
+        return None
+    path.parent.mkdir(parents=True, exist_ok=True)
+    backup = None
+    if existed:
+        # Never overwrite an earlier backup, including after the user changes languages again.
+        for number in range(10000):
+            suffix = "" if number == 0 else f".{number}"
+            candidate = path.with_name(path.name + ".before-korean" + suffix + ".bak")
+            try:
+                with candidate.open("xb") as stream:
+                    stream.write(original)
+                backup = candidate
+                break
+            except FileExistsError:
+                continue
+        else:
+            raise OSError("No free backup name; settings were not changed")
+    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
+    try:
+        with os.fdopen(fd, "wb") as stream:
+            stream.write(updated)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+    return backup
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("ini", type=Path)
+    args = parser.parse_args()
+    backup = apply(args.ini)
+    print(f"Korean game/menu selected: {args.ini}")
+    if backup:
+        print(f"Previous settings: {backup}")
+    overrides = [key for key in ("TOTK_LANG", "TOTK_MENU_LANG") if os.environ.get(key)]
+    if overrides:
+        print("Environment overrides still take priority: " + ", ".join(overrides))
+
+
+if __name__ == "__main__":
