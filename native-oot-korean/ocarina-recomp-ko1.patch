+// The menu language, re-read when cfg_version changes. Unknown/unset values follow the system UI language.
 static const char *resolve_menu_lang(void) {
     const char *v = cfg_value("TOTK_MENU_LANG");
     if (v && !strcmp(v, "ru")) return "ru";
     if (v && !strcmp(v, "en")) return "en";
+    if (v && !strcmp(v, "ko")) return "ko";
     const char *sys = plat_ui_language();
+    if (sys && (!strcmp(sys, "ko") || !strncmp(sys, "ko-", 3) || !strncmp(sys, "ko_", 3))) return "ko";
