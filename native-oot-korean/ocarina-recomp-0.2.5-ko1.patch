@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+"""Check checked-anchor update behavior with authored source fragments, never generated game code."""
+import importlib.util
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+PATCHER = Path(__file__).resolve().parents[1] / 'tools/oot/patch_generated.py'
+spec = importlib.util.spec_from_file_location('oot_patcher', PATCHER)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+def fixture(folder):
+    root = folder / 'main'
+    root.mkdir()
+    chunks = {}
+    for name, old, _ in module.EDITS:
+        chunks[name] = chunks.get(name, '/* Authored anchor fixture. */\n') + old
+    for name, text in chunks.items():
+        (root / name).write_text(text)
+    return root
+
+
+with tempfile.TemporaryDirectory() as temp:
+    base = Path(temp)
+    good = base / 'good'; good.mkdir()
+    root = fixture(good)
+    subprocess.run([sys.executable, str(PATCHER), str(good)], check=True)
+    before = {p.name: (p.read_bytes(), p.stat().st_mtime_ns) for p in root.iterdir()}
+    subprocess.run([sys.executable, str(PATCHER), str(good)], check=True)
+    assert before == {p.name: (p.read_bytes(), p.stat().st_mtime_ns) for p in root.iterdir()}
+    bad = base / 'bad'; bad.mkdir()
+    root = fixture(bad)
+    last, anchor, _ = module.EDITS[-1]
+    p = root / last
+    p.write_text(p.read_text().replace(anchor, '/* missing anchor */\n'))
+    before = {p.name: (p.read_bytes(), p.stat().st_mtime_ns) for p in root.iterdir()}
+    result = subprocess.run([sys.executable, str(PATCHER), str(bad)], capture_output=True)
+    assert result.returncode != 0
+    assert before == {p.name: (p.read_bytes(), p.stat().st_mtime_ns) for p in root.iterdir()}
+print('PASS: initial patch, unchanged bytes/timestamps on repeat, late-anchor failure leaves every input intact')
diff --git a/tests/spirv_sqrt_clamp_test.py b/tests/spirv_sqrt_clamp_test.py
new file mode 100644
index 0000000..0799253
--- /dev/null
+++ b/tests/spirv_sqrt_clamp_test.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""Validate the runtime transform on authored GLSL, not game shaders (glslang + spirv-val)."""
+import argparse
+import ctypes
+import os
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def instructions(words):
+    i = 5
+    while i < len(words):
+        n = words[i] >> 16
+        assert n and i + n <= len(words)
+        yield words[i] & 65535, words[i:i+n]
+        i += n
+    assert i == len(words)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cc', default='cc')
+    parser.add_argument('--glslang', default='glslangValidator')
+    parser.add_argument('--validator', default='spirv-val')
+    args = parser.parse_args()
+    os.environ.pop('OOT_SQRT_CLAMP', None)
+    source = (ROOT / 'runtime/vk_pipeline.c').read_text()
+    begin = source.index('static uint32_t *spirv_sqrt_clamp_mode(')
+    end = source.index('static const uint32_t *fs_spirv_over', begin)
+    shaders = {
+        'vert': 'layout(location=0) in vec4 value; void main(){gl_Position=sqrt(value);}',
+        'frag': 'layout(location=0) in vec4 value; layout(location=0) out vec4 color; '
+                'void main(){color=vec4(sqrt(value.x),sqrt(value.xy).x,sqrt(value.xyz).y,sqrt(value).z);}',
+        'comp': 'layout(local_size_x=1) in; layout(set=0,binding=0) buffer B{vec4 value;}; '
+                'void main(){value=sqrt(value)+vec4(sqrt(value.x));}',
+    }
+    with tempfile.TemporaryDirectory() as temp:
+        folder = Path(temp)
+        stub = folder / 'test.c'
+        stub.write_text('#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n'
+                        'static void rt_fatal(const char *s){(void)s;abort();}\n' + source[begin:end] +
+                        '\nvoid *test_apply(const uint32_t*w,uint64_t n,uint64_t*out,int mode){'
+                        'if(mode==-1)return spirv_sqrt_clamp(w,n,out);'
+                        'return spirv_sqrt_clamp_mode(w,n,out,mode);}\nvoid test_free(void*p){free(p);}\n')
+        libpath = folder / 'test.so'
+        subprocess.run([args.cc, '-std=c11', '-O2', '-Wall', '-Wextra', '-Werror', '-shared', '-fPIC',
+                        str(stub), '-o', str(libpath)], check=True)
+        lib = ctypes.CDLL(str(libpath))
+        lib.test_apply.argtypes = [ctypes.POINTER(ctypes.c_uint32), ctypes.c_uint64,
+                                   ctypes.POINTER(ctypes.c_uint64), ctypes.c_int]
+        lib.test_apply.restype = ctypes.POINTER(ctypes.c_uint32)
+        lib.test_free.argtypes = [ctypes.c_void_p]
+
+        def transform(words, mode):
+            array = (ctypes.c_uint32 * len(words))(*words)
+            size = ctypes.c_uint64(0)
+            result = lib.test_apply(array, len(words), ctypes.byref(size), mode)
+            assert list(array) == words, 'original shader was mutated'
+            if not result:
+                assert size.value == 0
+                return None
+            try:
+                return list(result[:size.value])
+            finally:
+                lib.test_free(result)
+
+        count = 0
+        for stage, body in shaders.items():
+            path = folder / ('authored.' + stage)
+            path.write_text('#version 450\n' + body)
+            original = folder / (stage + '.spv')
+            subprocess.run([args.glslang, '-V', '--target-env', 'vulkan1.2', str(path), '-o', str(original)],
+                           check=True, capture_output=True)
+            raw = original.read_bytes()
+            words = list(struct.unpack('<' + 'I'*(len(raw)//4), raw))
+            sqrt_count = sum(op == 12 and row[4] == 31 for op, row in instructions(words))
+            assert sqrt_count > 0
+            assert transform(words, 0) is None
+            assert transform(words, -1) is None  # Preserve the player's already-correct Link by default.
+            for mode in (1, 2):
+                output = transform(words, mode)
+                if mode == 1 and stage != 'comp':
+                    assert output is None
+                    continue
+                assert output is not None
+                rows = list(instructions(output))
+                assert sum(op == 12 and row[4] == 80 for op, row in rows) == sqrt_count
+                ids = {row[2] for op, row in rows if op == 12 and row[4] == 80}
+                assert all(row[5] in ids for op, row in rows if op == 12 and row[4] == 31)
+                types = {row[1] for op, row in rows if op == 12 and row[4] == 31}
+                zeros = [row for op, row in rows if op == 46 and row[1] in types]
+                assert len(zeros) == len(types)
+                assert all(row[2] < output[3] for row in zeros)
+                generated = folder / ('out-' + stage + '-' + str(mode) + '.spv')
+                generated.write_bytes(struct.pack('<' + 'I'*len(output), *output))
+                subprocess.run([args.validator, '--target-env', 'vulkan1.2', str(generated)], check=True)
+                count += 1
+            # Unknown types must make forward progress instead of looping forever.
+            unknown = words[:]
+            i = 5
+            while i < len(unknown):
+                n = unknown[i] >> 16
+                if unknown[i] & 65535 == 12 and unknown[i+4] == 31:
+                    unknown[i+1] = unknown[3] + 1
+                i += n
+            assert transform(unknown, 2) is None
+            for bad in ([], words[:4], words[:5]+[15], words[:5]+[(4 << 16)|15],
+                        words[:5]+[(2 << 16)|22, 1], words[:5]+[0]):
+                assert transform(bad, 2) is None
+            no_sqrt = words[:]
+            i = 5
+            while i < len(no_sqrt):
+                n = no_sqrt[i] >> 16
+                if no_sqrt[i] & 65535 == 12 and no_sqrt[i+4] == 31:
+                    no_sqrt[i+4] = 32  # InverseSqrt is outside this patch's scope.
+                i += n
+            assert transform(no_sqrt, 2) is None
+        print(f'PASS: {count} transformed vertex/fragment/compute modules validated; '
+              'scalar/vector types, compute-only/off modes, unknown types, malformed lengths, source preservation')
+
+
+if __name__ == '__main__':
+    main()
