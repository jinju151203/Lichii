+++ b/tools/oot/test_perf_policy.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+"""Exercise actual diagnostic/worker code with authored data and counting stubs; no game/GPU required."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def block(source, marker):
+    begin = source.index(marker)
+    start = source.index('{', begin)
+    end, depth = start + 1, 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cc', default='cc')
+    args = parser.parse_args()
+    draw = (ROOT / 'runtime/vk_exec_draw.c').read_text()
+    diagnostic = block(draw, '    {   // Material diagnostics only inspect resources while their output can be used.')
+    pipeline = (ROOT / 'runtime/vk_pipeline.c').read_text()
+    start = pipeline.index('    // Speculative NVIDIA builds can slow foreground replay')
+    end = pipeline.index('    LB.t0 = now_ms();', start)
+    policy = pipeline[start:end]
+    fixture = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#define NVN_STAGE_FS 1
+#define GFX_RES_SSBO 1
+#define VK_MEM_INSPECT_POOL_IMPORT 1
+#define LB_MAX_THREADS 16
+typedef struct { uint64_t addr, size; } p_bind_buf;
+typedef struct { p_bind_buf ssbo[6][16], ubo[6][16]; unsigned pass_w; } Ex;
+typedef struct { int pool_kind; } VkMemInspect;
+typedef struct { int cbuf_slot, handle; } GfxShaderRes;
+typedef struct { struct { unsigned vendorID; } props; } VkCtx;
+static VkCtx context;
+static int no_context;
+static const VkCtx *vk_ctx(void) { return no_context ? NULL : &context; }
+static struct { uint64_t frames; } gfx_counters;
+static int flash, lookups, scans, inspections;
+static char *diagnostic_getenv(const char *name) { (void)name; ++lookups; return flash ? "1" : NULL; }
+static int gfx_shader_resources(const void *s, int kind, const GfxShaderRes **out) {
+    (void)s; (void)kind; static GfxShaderRes r = {0, 0x530 / 4}; ++scans; *out = &r; return 1;
+}
+static int vk_mem_inspect(uint64_t addr, unsigned size, VkMemInspect *out) {
+    (void)addr; (void)size; ++inspections; out->pool_kind = VK_MEM_INSPECT_POOL_IMPORT; return 1;
+}
+static void rt_log(const char *format, ...) { (void)format; }
+#define getenv diagnostic_getenv
+static void diagnose(Ex *ex, const void *fs)
+''' + diagnostic + r'''
+#undef getenv
+static int workers(unsigned vendor, int cpus, const char *te, size_t n, int absent) {
+    context.props.vendorID = vendor; no_context = absent;
+''' + policy + r'''
+    return t;
+}
+int main(int argc, char **argv) {
+    assert(argc == 4);
+    flash = atoi(argv[1]); gfx_counters.frames = strtoull(argv[2], NULL, 10);
+    int expected_scans = atoi(argv[3]);
+    float memory[200] = {0}, original[200] = {0};
+    Ex ex = {0}; ex.pass_w = 1280;
+    ex.ssbo[NVN_STAGE_FS][2].addr = (uintptr_t)memory;
+    ex.ubo[NVN_STAGE_FS][3] = (p_bind_buf){(uintptr_t)memory, sizeof memory};
+    for (int i = 0; i < 200; ++i) diagnose(&ex, (const void *)1);
+    assert(lookups == 1); assert(scans == expected_scans);
+    assert(inspections == ((gfx_counters.frames >= 1700 && gfx_counters.frames < 1801) ? 1 : 0));
+    assert(!memcmp(memory, original, sizeof memory));
