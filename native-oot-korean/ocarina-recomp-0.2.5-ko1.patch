+++ b/tools/oot/test_c0_translator.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Verify the rebuilt translator's C0 contract with authored Maxwell instructions, without game data/GPU."""
+import argparse
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / 'tests'))
+import storage_candidates_fixture as fixture
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--translator', type=Path, required=True)
+    args = parser.parse_args()
+    ops = [fixture.movc(0, 0, 4), fixture.movc(1, 0, 5),
+           (fixture.global_memory(False, 0, 0) & ~(7 << 48)) | (5 << 48),
+           fixture.global_memory(False, 2, 0), fixture.movc(4, 0, 8), fixture.movc(5, 0, 9),
+           fixture.global_memory(True, 2, 4), fixture.EXIT]
+    words = []
+    for i in range(0, len(ops), 3):
+        batch = ops[i:i + 3]
+        words += [fixture.SCHED] + batch + [0] * (3 - len(batch))
+    with tempfile.TemporaryDirectory() as temp:
+        folder = Path(temp)
+        shader = folder / 'authored.bin'
+        shader.write_bytes(struct.pack('<' + 'Q' * len(words), *words))
+        base = dict(stage='cs', code=str(shader), debug=False, c1=bytes(256).hex(), local=[1, 1, 1], shared=0,
+                    c0=[0, 0, 0, 0], c0_version=2, c0_roots=[8, 0, 0, 0, 0, 0, 0, 0], sbuf_align=256)
+        jobs = [dict(base, key='indirect', storage_candidates_version=1),
+                dict(base, key='unknown', storage_candidates_version=2)]
+        run = subprocess.run([str(args.translator.resolve()), '--serve'],
+                             input=''.join(json.dumps(dict(job=job, out=str(folder))) + '\n' for job in jobs),
+                             capture_output=True, text=True, timeout=90)
+        assert run.returncode == 0, run.stdout + run.stderr
+        replies = run.stdout.splitlines()
+        assert replies[0] == 'ok indirect' and replies[1].startswith('fail unknown '), replies
+        assert not (folder / 'unknown.res.json').exists()
+        result = json.loads((folder / 'indirect.res.json').read_text())
+        assert result['storage_candidates_version'] == 1
+        offsets = {row['cb_offset'] for row in result['sbufs'] if row['cb_slot'] == 0}
+        expected = {(0x900 + index * 16) // 4 for index in range(32)}
+        assert expected <= offsets, (expected - offsets)
+        assert not any((0x800 + index * 16) // 4 in offsets for index in range(16))
+        spirv = (folder / 'indirect.spv').read_bytes()
+        words = struct.unpack('<' + 'I' * (len(spirv) // 4), spirv)
+        assert words[0] == 0x07230203
+        index = 5
+        while index < len(words):
+            count = words[index] >> 16
+            assert count and index + count <= len(words)
+            index += count
+    print('C0 translator PASS: 32 relocated candidates, guarded ABI, unknown-version refusal, SPIR-V structure')
+
+
+if __name__ == '__main__':
+    main()
