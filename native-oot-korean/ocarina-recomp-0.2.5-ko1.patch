@@ -1,7 +1,16 @@
-﻿# Abre o Ocarina Recomp.
+﻿# Abre o Ocarina Recomp. -Diagnostico collects measured frame logs after the game closes.
+param([switch]$Diagnostico)
+$ErrorActionPreference = 'Stop'
 $env:PATH = "C:\msys64\ucrt64\bin;$env:PATH"
 if (Get-CimInstance Win32_VideoController | Where-Object { $_.Name -match 'NVIDIA' }) { $env:TOTK_GPU_NAME = "NVIDIA" }
 $raiz = Split-Path $PSScriptRoot -Parent
+$exePath = [IO.Path]::GetFullPath((Join-Path $raiz 'build\oot111\ocarina.exe'))
+# Two copies share the same logs and caches and can exhaust VRAM. Do not launch the same installation twice.
+if (Get-Process ocarina -ErrorAction SilentlyContinue | Where-Object { $_.Path -and [string]::Equals($_.Path, $exePath, [StringComparison]::OrdinalIgnoreCase) }) {
+    Add-Type -AssemblyName System.Windows.Forms
+    [void][Windows.Forms.MessageBox]::Show('이 설치 폴더의 게임이 이미 실행 중입니다. 기존 게임 창을 확인하세요.', 'Ocarina Recomp', 'OK', 'Information')
+    exit 0
+}
 $env:TOTK_PROFILE_DIR = Join-Path $raiz "perfil"
 # The previous run's logs go to logs\ (the newest 10 runs) before this one overwrites them: a crash log used to be lost
 # as soon as the game was opened again. jogar\medir-partida.ps1 reads them.
@@ -25,4 +34,10 @@ if ((Test-Path -LiteralPath $erros) -and (Get-Item -LiteralPath $erros).Length -
 }
 Set-Location (Join-Path $raiz "build\oot111")
 $extras = if ($args.Count) { @{ ArgumentList = $args } } else { @{} }
-Start-Process .\ocarina.exe @extras -RedirectStandardOutput $saida -RedirectStandardError $erros
+if ($Diagnostico) { $env:TOTK_TRACE = 'perf'; $env:TOTK_PERF_OVERLAY = 'full' }
+$game = Start-Process .\ocarina.exe @extras -PassThru -RedirectStandardOutput $saida -RedirectStandardError $erros
+[void]$game.Handle
+$game.WaitForExit()
+if ($Diagnostico -or ($null -ne $game.ExitCode -and $game.ExitCode -ne 0)) {
+    & (Join-Path $PSScriptRoot 'collect-diagnostics.ps1')
+}
