+#!/usr/bin/env python3
+"""Run with Python 3; the C catalog tests also require a C compiler (CC or cc)."""
+from __future__ import annotations
+import ctypes
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+import unittest
+
+from set_korean import apply, korean_config
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+class ConfigTests(unittest.TestCase):
+    def test_preserves_unrelated_bytes_bom_crlf(self):
+        before = '\ufeff; 메모\r\n[display]\r\nfullscreen = 0\r\n[language]\r\nlang = en-US\r\nmenu_lang = ru\r\n'.encode()
+        expected = before.replace(b'lang = en-US', b'lang = ko').replace(b'menu_lang = ru', b'menu_lang = ko')
+        self.assertEqual(korean_config(before), expected)
+
+    def test_case_prefix_duplicates_no_final_newline(self):
+        after = korean_config(b'LANG=ja\nTOTK_lang="en-US"\nmenu_LANG=ru')
+        self.assertEqual(after, b'LANG=ko\nTOTK_lang=ko\nmenu_LANG=ko')
+
+    def test_missing_keys_and_idempotence(self):
+        for before in (b'', b'[sound]\nvolume=0.5', b'lang=ko\r\n', b'; lang=ja\n'):
+            after = korean_config(before)
+            self.assertIn(b'menu_lang = ko', after)
+            self.assertEqual(korean_config(after), after)
+
+    def test_backup_and_reapplication(self):
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / '한글 폴더' / 'totk.ini'
+            path.parent.mkdir()
+            original = b'volume=0.3\nlang=ja\n'
+            path.write_bytes(original)
+            first = apply(path)
+            self.assertEqual(first.read_bytes(), original)
+            self.assertIsNone(apply(path))
+            path.write_bytes(b'lang=en-US\n')
+            second = apply(path)
+            self.assertNotEqual(first, second)
+            self.assertEqual(first.read_bytes(), original)
+            self.assertEqual(second.read_bytes(), b'lang=en-US\n')
+
+    def test_bad_encoding_leaves_file_untouched(self):
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / 'totk.ini'
+            path.write_bytes(b'\xff\xfeL\x00')
+            with self.assertRaises(UnicodeDecodeError):
+                apply(path)
+            self.assertEqual(path.read_bytes(), b'\xff\xfeL\x00')
+            self.assertEqual(list(path.parent.iterdir()), [path])
+
+
+class CatalogTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.tmp = tempfile.TemporaryDirectory()
+        folder = Path(cls.tmp.name)
+        stub = folder / 'stubs.c'
+        stub.write_text('''
+#include "ui_text.h"
+#include <string.h>
+static unsigned version;
+static const char *explicit_lang, *system_lang;
+const char *cfg_value(const char *name) { (void)name; return explicit_lang; }
+unsigned cfg_version(void) { return version; }
+const char *plat_ui_language(void) { return system_lang; }
+const char *ov_language(void) { return "ko"; }
+void test_select(const char *explicit_value, const char *system_value) {
+    explicit_lang = explicit_value; system_lang = system_value; ++version;
+}
+int test_count(void) { return UI_TEXT_COUNT; }
+int test_title(void) { return UI_MENU_TITLE; }
+''')
+        lib = folder / 'catalog.so'
+        subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-Wall', '-Wextra', '-Werror', '-fPIC', '-shared',
+                        '-I', str(ROOT / 'runtime'), str(ROOT / 'runtime/ui_text.c'), str(stub), '-o', str(lib)], check=True)
+        cls.lib = ctypes.CDLL(str(lib))
+        cls.lib.ui_text_in.argtypes = [ctypes.c_char_p, ctypes.c_int]
+        cls.lib.ui_text_in.restype = ctypes.c_char_p
+        cls.lib.ui_text_defined.argtypes = [ctypes.c_char_p, ctypes.c_int]
+        cls.lib.menu_text.argtypes = [ctypes.c_int]
+        cls.lib.menu_text.restype = ctypes.c_char_p
+        cls.lib.test_select.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
+        cls.lib.ui_text_lang.argtypes = [ctypes.c_char_p]
+        cls.lib.ui_text_lang.restype = ctypes.c_char_p
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.tmp.cleanup()
+
+    def test_every_catalog_entry_and_printf_signature(self):
+        # Catalog formats use no space flag. Descriptions also contain literal "100 % smooths...".
+        fmt = re.compile(r'%(?:[-+#0]*\d*(?:\.\d+)?(?:hh|ll|[hljztL])?[diuoxXfFeEgGaAcspn]|%)')
+        for number in range(self.lib.test_count()):
+            self.assertTrue(self.lib.ui_text_defined(b'ko', number), f'missing Korean id {number}')
+            en = self.lib.ui_text_in(b'en', number).decode('utf-8')
+            ko = self.lib.ui_text_in(b'ko', number).decode('utf-8')
+            self.assertEqual(fmt.findall(en), fmt.findall(ko), f'printf mismatch id {number}')
+            self.assertLess(len(ko.encode()), 2048, f'description buffer id {number}')
+
+    def test_live_menu_switch_and_system_fallback(self):
+        for explicit, system, expected in (
+            (b'ko', b'en-US', '설정'), (b'en', b'ko-KR', 'Settings'),
+            (None, b'ko-KR', '설정'), (b'', b'ko', '설정'), (None, b'ko_KR', '설정'),
+            (b'ru', b'ko-KR', 'Настройки'), (None, b'ru-RU', 'Настройки'),
+            (None, b'fr-FR', 'Settings'), (None, None, 'Settings'),
+            (b'ko', None, '설정'), (b'unknown', b'ko-KR', '설정')):
+            self.lib.test_select(explicit, system)
+            self.assertEqual(self.lib.menu_text(self.lib.test_title()).decode(), expected)
+
+    def test_korean_region_alias(self):
+        for value in (b'ko', b'ko-KR', b'ko_KR'):
+            self.assertEqual(self.lib.ui_text_lang(value), b'ko')
+
+    def test_real_imgui_font_atlas_at_1080p_and_4k_ui_scale(self):
+        folder = Path(self.tmp.name)
+        imgui = ROOT / 'runtime/third_party/imgui'
+        exe = folder / 'atlas'
+        subprocess.run([os.environ.get('CXX', 'c++'), '-std=c++20', '-O2',
+                        '-I', str(ROOT / 'runtime'), '-I', str(imgui),
+                        str(ROOT / 'tools/oot/check_korean_atlas.cpp'),
+                        *(str(imgui / name) for name in ('imgui.cpp', 'imgui_draw.cpp', 'imgui_tables.cpp', 'imgui_widgets.cpp')),
+                        str(folder / 'catalog.so'), f'-Wl,-rpath,{folder}', '-o', str(exe)], check=True)
+        subprocess.run([str(exe), str(ROOT / 'runtime/ui/fonts/OcarinaMenuKR.otf')], check=True)
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
