@@ -0,0 +1,43 @@
+// Uses the same glyph builder and stb renderer as the real menu; no GPU/game data required.
+#include <cstdio>
+#include <fstream>
+#include <iterator>
+#include <vector>
+#include "ui/catalog_glyphs.h"
+
+int main(int argc, char **argv) {
+    if (argc != 2) return 2;
+    std::ifstream input(argv[1], std::ios::binary);
+    std::vector<char> bytes((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+    if (bytes.size() < 100) return 3;
+    ImGui::CreateContext();
+    ImFontAtlas *atlas = ImGui::GetIO().Fonts;
+    for (float pixels : {26.0f, 52.0f}) {
+        atlas->Clear();
+        ImFontConfig base;
+        base.SizePixels = pixels;
+        ImFont *font = atlas->AddFontDefault(&base);
+        ImFontGlyphRangesBuilder builder;
+        menu_catalog_glyphs(builder, "ko");
+        ImVector<ImWchar> ranges;
+        builder.BuildRanges(&ranges);
+        ImFontConfig config;
+        config.MergeMode = true;
+        config.FontDataOwnedByAtlas = false;
+        if (!atlas->AddFontFromMemoryTTF(bytes.data(), (int)bytes.size(), pixels, &config, ranges.Data)) return 4;
+        if (!atlas->Build()) return 5;
+        int count = 0;
+        for (int i = 0; ranges[i]; i += 2)
+            for (unsigned cp = ranges[i]; cp <= ranges[i + 1]; ++cp) {
+                if (!font->FindGlyphNoFallback((ImWchar)cp)) {
+                    std::fprintf(stderr, "Missing U+%04X at %.0f px\n", cp, pixels);
+                    return 6;
+                }
+                ++count;
+            }
+        std::printf("%.0f px: %d glyphs, atlas %dx%d, no missing characters\n",
+                    pixels, count, atlas->TexWidth, atlas->TexHeight);
+        atlas->ClearInputData();
+    }
+    ImGui::DestroyContext();
+}
diff --git a/tools/oot/export_analysis.py b/tools/oot/export_analysis.py
new file mode 100644
index 0000000..5d86572
--- /dev/null
+++ b/tools/oot/export_analysis.py
@@ -0,0 +1,107 @@
+#!/usr/bin/env python3
+"""Copy the player's installed ExeFS and diagnostics to a private analysis ZIP; never publishes anything."""
+from __future__ import annotations
+import argparse
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import secrets
+import tempfile
+import zipfile
+import sys
+
+# The setup's embeddable Python uses ._pth and omits the script directory, even for a script passed by full path.
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from import_save import reparse
+
+MODULES = ('main', 'main.npdm', 'rtld', 'sdk', 'subsdk0')
+MAIN_111 = 'f90499eeb596d67c730fac9b7e247b3a46d51d6f334c767aef071c9a783cccef'
+
+
+def export(root: Path, exefs: Path | None = None, diagnostic: Path | None = None,
+           output: Path | None = None, scene: str = '') -> dict:
+    root = root.resolve()
+    source = (exefs or root / 'build/exefs').resolve()
+    main = source / 'main'
+    if not main.is_file() or reparse(main):
+        raise ValueError('build\\exefs\\main을 찾지 못했습니다. 설치를 완료하거나 올바른 exefs 폴더를 선택하세요.')
+    with main.open('rb') as stream:
+        if stream.read(4) != b'NSO0':
+            raise ValueError('설치 프로그램이 준비한 NSO0 형식의 main 파일이 필요합니다.')
+    output = (output or root / 'diagnostics' / ('oot-analysis-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S') + '-' + secrets.token_hex(4) + '.zip')).resolve()
+    if output.suffix.lower() != '.zip' or source == output.parent or source in output.parents:
+        raise ValueError('분석 ZIP은 exefs 원본 폴더 밖에 저장해야 합니다.')
+    if output.exists():
+        raise ValueError('이미 같은 이름의 파일이 있습니다. 새 파일 이름을 사용하세요.')
+    files = [(source / name, 'exefs/' + name) for name in MODULES if (source / name).exists()]
+    if diagnostic:
+        diagnostic = diagnostic.resolve()
+        if not diagnostic.is_file() or reparse(diagnostic) or diagnostic == output:
+            raise ValueError('올바른 진단 ZIP이 필요합니다.')
+        with zipfile.ZipFile(diagnostic) as archive:
+            if archive.testzip() is not None:
+                raise ValueError('진단 ZIP의 무결성 검사에 실패했습니다.')
+        files.append((diagnostic, 'diagnostics.zip'))
+    for path, _ in files:
+        if not path.is_file() or reparse(path):
+            raise ValueError('연결 파일은 내보낼 수 없습니다: ' + path.name)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    fd, temporary = tempfile.mkstemp(prefix='.oot-analysis-', suffix='.tmp', dir=output.parent)
+    os.close(fd)
+    entries = []
+    try:
+        with zipfile.ZipFile(temporary, 'w', compression=zipfile.ZIP_DEFLATED, compresslevel=6) as archive:
+            for path, name in files:
+                before = path.stat()
+                digest = hashlib.sha256()
+                size = 0
+                with path.open('rb') as src, archive.open(name, 'w', force_zip64=True) as dst:
+                    for chunk in iter(lambda: src.read(1024 * 1024), b''):
+                        dst.write(chunk); digest.update(chunk); size += len(chunk)
+                after = path.stat()
+                if (before.st_size, before.st_mtime_ns, before.st_ino) != (after.st_size, after.st_mtime_ns, after.st_ino) or size != before.st_size:
+                    raise ValueError('내보내는 중 파일이 바뀌었습니다. 게임과 설치 프로그램을 종료한 뒤 다시 시도하세요.')
+                entries.append(dict(name=name, size=size, sha256=digest.hexdigest()))
+            main_hash = next(row['sha256'] for row in entries if row['name'] == 'exefs/main')
+            info = dict(package='0.2.5-ko1', kind='private-game-code-analysis', scene=scene[:10000],
+                        matches_ocarina_111=main_hash == MAIN_111, files=entries,
+                        missing_modules=[name for name in MODULES if not (source / name).exists()],
+                        contents='Player-owned executable modules and optional diagnostic logs. No RomFS, save data, NUP or keys.')
+            archive.writestr('analysis.json', json.dumps(info, ensure_ascii=False, indent=2))
+        with zipfile.ZipFile(temporary) as archive:
+            if archive.testzip() is not None:
+                raise OSError('분석 ZIP 검증에 실패했습니다.')
+        # Reserve the name rather than replacing any existing user file.
+        with output.open('xb'):
+            pass
+        try:
+            os.replace(temporary, output)
+        except BaseException:
+            output.unlink()
+            raise
+        return dict(zip=str(output), bytes=output.stat().st_size, matches_ocarina_111=info['matches_ocarina_111'], files=len(entries))
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--root', type=Path, required=True)
+    parser.add_argument('--exefs', type=Path)
+    parser.add_argument('--diagnostic', type=Path)
+    parser.add_argument('--output', type=Path)
+    parser.add_argument('--scene', default='')
+    args = parser.parse_args()
+    try:
+        print(json.dumps(export(args.root, args.exefs, args.diagnostic, args.output, args.scene), ensure_ascii=True))
+        return 0
+    except (OSError, ValueError, zipfile.BadZipFile) as error:
+        print(json.dumps({'error': str(error)}, ensure_ascii=True))
+        return 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/tools/oot/import_save.py b/tools/oot/import_save.py
new file mode 100644
index 0000000..0999eef
--- /dev/null
+++ b/tools/oot/import_save.py
@@ -0,0 +1,230 @@
+#!/usr/bin/env python3
+"""Import an unpacked Lichii Ocarina save into the native account, with verified copy and rollback."""
+from __future__ import annotations
+import argparse
+import ctypes
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import secrets
+import shutil
+import stat
+import tempfile
+
+TITLE = '0400486024DEC000'
+
+
+def reparse(path: Path) -> bool:
+    info = path.lstat()
+    return stat.S_ISLNK(info.st_mode) or bool(getattr(info, 'st_file_attributes', 0) & 0x400)
+
+
+def is_save(path: Path) -> bool:
+    try:
+        if reparse(path) or not path.is_dir():
+            return False
+        account = path / 'account.sav'
+        if account.is_file() and not reparse(account) and account.stat().st_size:
+            return True
+        for child in path.iterdir():
+            if re.fullmatch(r'slot_\d{2}', child.name, re.I) and not reparse(child):
+                if child.is_file() and child.stat().st_size:
+                    return True
+                if child.is_dir() and any(p.is_file() and not reparse(p) and p.stat().st_size for p in child.iterdir()):
+                    return True
+    except OSError:
+        pass
+    return False
+
+
+def discover(roots: list[Path], appdata: Path | None = None) -> list[dict]:
+    candidates: dict[str, dict] = {}
+    starts = list(roots)
+    if appdata:
+        starts += [appdata / name / 'nand/user/save' for name in ('eden', 'lichii', 'Lichii', 'Eden', 'eglantine', 'yuzu', 'citron', 'sudachi')]
+    for start in starts:
+        if not start.is_dir() or reparse(start):
+            continue
+        start = start.resolve()
+        if is_save(start):
+            walks = [(str(start), [], [])]
+        else:
+            walks = os.walk(start, followlinks=False)
+        visited = 0
+        for folder, dirs, _files in walks:
+            visited += 1
+            if visited > 10000:
+                break
+            path = Path(folder)
+            dirs[:] = [name for name in dirs if not reparse(path / name)]
+            if len(path.relative_to(start).parts) >= 10:
+                dirs.clear()
+            # Direct save selection is accepted; ancestor scans must stay under this game's title ID.
+            if path != start and not any(part.upper() == TITLE for part in path.parts):
+                continue
+            if is_save(path):
+                try:
+                    files = inventory(path)
+                except (OSError, ValueError):
+                    continue
+                key = os.path.normcase(str(path))
+                account = next((part for part in reversed(path.parts) if re.fullmatch('[0-9a-fA-F]{32}', part)), '')
+                candidates[key] = dict(path=str(path), account=account, files=len(files), bytes=sum(p.stat().st_size for p in files),
+                                       modified_ns=max(p.stat().st_mtime_ns for p in files))
+                dirs.clear()
+    return sorted(candidates.values(), key=lambda row: row['modified_ns'], reverse=True)
+
+
+def inventory(root: Path) -> list[Path]:
+    files = []
+    for folder, dirs, names in os.walk(root, followlinks=False):
+        for name in dirs + names:
+            path = Path(folder) / name
+            if reparse(path):
+                raise ValueError('연결된 폴더나 파일은 가져올 수 없습니다: ' + str(path))
+            if path.is_file():
+                if not stat.S_ISREG(path.stat().st_mode):
+                    raise ValueError('일반 저장 파일이 아닙니다: ' + str(path))
+                files.append(path)
+    return sorted(files)
+
+
+def check_processes() -> None:
+    if os.name != 'nt':
+        return
+    from ctypes import wintypes as w
+    class Entry(ctypes.Structure):
+        _fields_ = [('size', w.DWORD), ('usage', w.DWORD), ('pid', w.DWORD), ('heap', ctypes.c_size_t),
+                    ('module', w.DWORD), ('threads', w.DWORD), ('parent', w.DWORD), ('priority', w.LONG),
+                    ('flags', w.DWORD), ('exe', w.WCHAR * 260)]
+    kernel = ctypes.WinDLL('kernel32', use_last_error=True)
+    kernel.CreateToolhelp32Snapshot.argtypes = [w.DWORD, w.DWORD]
+    kernel.CreateToolhelp32Snapshot.restype = w.HANDLE
+    kernel.Process32FirstW.argtypes = kernel.Process32NextW.argtypes = [w.HANDLE, ctypes.POINTER(Entry)]
+    kernel.CloseHandle.argtypes = [w.HANDLE]
+    handle = kernel.CreateToolhelp32Snapshot(2, 0)
+    if handle == ctypes.c_void_p(-1).value:
+        raise OSError('게임 실행 여부를 확인하지 못했습니다.')
+    try:
+        entry = Entry(); entry.size = ctypes.sizeof(entry)
+        found = kernel.Process32FirstW(handle, ctypes.byref(entry))
+        while found:
+            if entry.exe.lower() in ('ocarina.exe', 'lichii.exe', 'eden.exe', 'eglantine.exe', 'yuzu.exe', 'citron.exe', 'sudachi.exe'):
+                raise ValueError('게임과 에뮬레이터를 종료한 뒤 다시 시도하세요: ' + entry.exe)
+            found = kernel.Process32NextW(handle, ctypes.byref(entry))
+    finally:
+        kernel.CloseHandle(handle)
+
+
+def import_save(source: Path, profile: Path) -> dict:
+    check_processes()
+    source, profile = source.resolve(), profile.resolve()
+    if source == profile or source in profile.parents or profile in source.parents:
+        raise ValueError('원본 저장 폴더와 포트 프로필 폴더는 서로 분리되어 있어야 합니다.')
+    if not is_save(source):
+        raise ValueError('account.sav 또는 slot_00 등 게임 저장 데이터가 있는 폴더를 선택하세요.')
+    profile.mkdir(parents=True, exist_ok=True)
+    if reparse(profile):
+        raise ValueError('프로필 경로에 연결된 폴더를 사용할 수 없습니다.')
+    uid_file = profile / 'account.uid'
+    if uid_file.exists() and (reparse(uid_file) or not uid_file.is_file()):
+        raise ValueError('account.uid는 일반 파일이어야 합니다.')
+    uid = uid_file.read_bytes() if uid_file.exists() else secrets.token_bytes(16)
+    if len(uid) != 16:
+        raise ValueError('account.uid 크기가 16바이트가 아닙니다. 기존 파일은 변경하지 않았습니다.')
+    destination = profile / 'save' / uid[::-1].hex()
+    tx = profile / 'save-tx'
+    for path in (destination.parent, destination, tx):
+        if path.exists() and reparse(path):
+            raise ValueError('대상 저장 경로에 연결된 폴더가 있습니다: ' + str(path))
+    backup = profile / 'save-import-backup' / (datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S') + '-' + secrets.token_hex(4))
+    files = inventory(source)
+    before = {p.relative_to(source).as_posix(): (p.stat().st_size, p.stat().st_mtime_ns) for p in files}
+    stage = Path(tempfile.mkdtemp(prefix='.save-import-', dir=profile))
+    staged = stage / 'save'
+    staged.mkdir()
+    old_moved = tx_moved = new_moved = uid_created = False
+    hashes = {}
+    try:
+        # Finish and verify every copy before changing either committed saves or pending transactions.
+        for path in files:
+            relative = path.relative_to(source)
+            output = staged / relative
+            output.parent.mkdir(parents=True, exist_ok=True)
+            digest = hashlib.sha256()
+            with path.open('rb') as src, output.open('xb') as dst:
+                for chunk in iter(lambda: src.read(1024 * 1024), b''):
+                    dst.write(chunk); digest.update(chunk)
+                dst.flush(); os.fsync(dst.fileno())
+            if output.stat().st_size != before[relative.as_posix()][0]:
+                raise ValueError('복사 중 원본 저장 데이터가 바뀌었습니다. 에뮬레이터를 종료하세요.')
+            with output.open('rb') as verify:
+                copied = hashlib.file_digest(verify, 'sha256').hexdigest()
+            if copied != digest.hexdigest():
+                raise OSError('복사한 저장 파일의 검증에 실패했습니다.')
+            hashes[relative.as_posix()] = copied
+        after = {p.relative_to(source).as_posix(): (p.stat().st_size, p.stat().st_mtime_ns) for p in inventory(source)}
+        if before != after:
+            raise ValueError('복사 중 원본 저장 데이터가 바뀌었습니다. 에뮬레이터를 종료하세요.')
+        check_processes()
+        backup.mkdir(parents=True)
+        if uid_file.exists():
+            shutil.copyfile(uid_file, backup / 'account.uid')
+        record = dict(source=str(source), destination=str(destination), backup=str(backup), files=len(files),
+                      bytes=sum(size for size, _time in before.values()), sha256=hashes)
+        (backup / 'manifest.json').write_text(json.dumps(record, ensure_ascii=False, indent=2), encoding='utf-8')
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        if destination.exists():
+            os.replace(destination, backup / 'save'); old_moved = True
+        if tx.exists():
+            os.replace(tx, backup / 'save-tx'); tx_moved = True
+        if not uid_file.exists():
+            with uid_file.open('xb') as stream:
+                uid_created = True
+                stream.write(uid); stream.flush(); os.fsync(stream.fileno())
+        elif uid_file.read_bytes() != uid:
+            raise ValueError('작업 중 포트 계정이 바뀌었습니다. 게임을 종료하세요.')
+        os.replace(staged, destination); new_moved = True
+        return record
+    except BaseException:
+        if new_moved:
+            os.replace(destination, staged)
+        if uid_created:
+            uid_file.unlink()
+        if tx_moved:
+            os.replace(backup / 'save-tx', tx)
+        if old_moved:
+            os.replace(backup / 'save', destination)
+        raise
+    finally:
+        shutil.rmtree(stage, ignore_errors=True)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--list', action='store_true')
+    parser.add_argument('--root', type=Path, action='append', default=[])
+    parser.add_argument('--source', type=Path)
+    parser.add_argument('--profile', type=Path)
+    parser.add_argument('--json', action='store_true')
+    args = parser.parse_args()
+    try:
+        if args.list:
+            appdata = Path(os.environ['APPDATA']) if not args.root and os.environ.get('APPDATA') else None
+            result = {'saves': discover(args.root, appdata)}
+        else:
+            if args.source is None or args.profile is None:
+                parser.error('--source and --profile are required for importing')
+            result = import_save(args.source, args.profile)
+        print(json.dumps(result, ensure_ascii=True))
+        return 0
+    except (OSError, ValueError) as error:
+        print(json.dumps({'error': str(error)}, ensure_ascii=True))
+        return 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
