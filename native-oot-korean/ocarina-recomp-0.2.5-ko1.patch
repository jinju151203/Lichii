+// Shared by the Vulkan menu and its CPU-only font atlas check.
+#pragma once
+#include "imgui.h"
+extern "C" {
+#include "ui_text.h"
+}
+
+inline void menu_catalog_glyphs(ImFontGlyphRangesBuilder &builder, const char *language) {
