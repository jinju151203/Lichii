+    exit 1
+}
diff --git a/instalador/bootstrap.ps1 b/instalador/bootstrap.ps1
new file mode 100644
index 0000000..b995e44
--- /dev/null
+++ b/instalador/bootstrap.ps1
@@ -0,0 +1,79 @@
+# The single-file EXE writes this script and payload.zip to its own unique temporary folder.
+# No downloads: the source, compiler and dependencies are already in the embedded ZIP.
+$ErrorActionPreference = 'Stop'
+Add-Type -AssemblyName System.Windows.Forms, System.Drawing, System.IO.Compression, System.IO.Compression.FileSystem
+[Windows.Forms.Application]::EnableVisualStyles()
+
+# Extraction on a .NET worker keeps the preparation window responsive; no PowerShell runspace on that thread.
+Add-Type -ReferencedAssemblies System.IO.Compression, System.IO.Compression.FileSystem -TypeDefinition @'
+using System;
+using System.IO;
+using System.IO.Compression;
+using System.Threading;
+using System.Threading.Tasks;
+public static class OcarinaBundle {
+    public static int Files;
+    public static Task Extract(string zip, string target) {
+        return Task.Run(() => {
+            string root = Path.GetFullPath(target).TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;
+            Directory.CreateDirectory(root);
+            using (ZipArchive archive = ZipFile.OpenRead(zip)) {
+                foreach (ZipArchiveEntry entry in archive.Entries) {
+                    string path = Path.GetFullPath(Path.Combine(root, entry.FullName));
+                    if (!path.StartsWith(root, StringComparison.OrdinalIgnoreCase)) throw new IOException("Invalid ZIP path");
+                    if (String.IsNullOrEmpty(entry.Name)) Directory.CreateDirectory(path);
+                    else {
+                        Directory.CreateDirectory(Path.GetDirectoryName(path));
+                        entry.ExtractToFile(path, false);
+                        Interlocked.Increment(ref Files);
+                    }
+                }
+            }
+        });
+    }
+}
+'@
+
+$window = New-Object Windows.Forms.Form
+$window.Text = 'Ocarina Recomp 한국어 설치'
+$window.ClientSize = New-Object Drawing.Size(510, 145)
+$window.StartPosition = 'CenterScreen'
+$window.FormBorderStyle = 'FixedDialog'
+$window.MaximizeBox = $false
+$window.ControlBox = $false
+$window.Font = New-Object Drawing.Font('Malgun Gothic', 10)
+$label = New-Object Windows.Forms.Label
+$label.SetBounds(22, 20, 470, 48)
+$label.Text = "한국어 설치 파일을 준비하고 있습니다.`n잠시 후 NUP 파일 선택 화면이 열립니다."
+$progress = New-Object Windows.Forms.ProgressBar
+$progress.SetBounds(22, 78, 466, 20)
+$progress.Style = 'Marquee'
+$count = New-Object Windows.Forms.Label
+$count.SetBounds(22, 106, 466, 24)
+$window.Controls.AddRange(@($label, $progress, $count))
+$destination = Join-Path $env:OCARINA_BUNDLE_DIR 'unpacked'
+$script:unpackTask = $null
+$timer = New-Object Windows.Forms.Timer
+$timer.Interval = 100
+$timer.add_Tick({
+    $count.Text = "파일 준비: $([OcarinaBundle]::Files)개"
+    if ($script:unpackTask -and $script:unpackTask.IsCompleted) { $timer.Stop(); $window.Close() }
+})
+$window.add_Shown({
+    $script:unpackTask = [OcarinaBundle]::Extract($env:OCARINA_BUNDLE_ZIP, $destination)
+    $timer.Start()
+})
+try {
+    [Windows.Forms.Application]::Run($window)
+    $script:unpackTask.GetAwaiter().GetResult()
+    $env:OCARINA_SETUP = Join-Path $destination 'Ocarina-Setup-0.2.5'
+    $installer = Join-Path $env:OCARINA_SETUP 'instalador\Instalar-Ocarina.ps1'
+    if (-not (Test-Path -LiteralPath $installer)) { throw '설치 스크립트를 찾지 못했습니다.' }
+    & $installer
+} catch {
+    [Windows.Forms.MessageBox]::Show("설치를 준비하지 못했습니다.`n`n$($_.Exception.Message)", 'Ocarina Recomp', 'OK', 'Error') | Out-Null
+    exit 1
+} finally {
+    $timer.Dispose()
+    $window.Dispose()
+}
diff --git a/instalador/singlefile.c b/instalador/singlefile.c
new file mode 100644
index 0000000..f9c00ea
--- /dev/null
+++ b/instalador/singlefile.c
@@ -0,0 +1,101 @@
+// Single-file Korean setup: unpack the bundled tools/source, then run the native-build installer.
+// The game is built from the player's own NUP on their PC. No game executable is embedded here.
+#ifndef UNICODE
+#define UNICODE 1
+#endif
+#ifndef _UNICODE
+#define _UNICODE 1
+#endif
+#include <windows.h>
+#include <objbase.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <wchar.h>
+
+#define PATH_CAP 32768
+
+static int write_resource(int id, const wchar_t *file) {
+    HRSRC resource = FindResourceW(NULL, MAKEINTRESOURCEW(id), RT_RCDATA);
+    if (!resource) return 0;
+    DWORD size = SizeofResource(NULL, resource), written = 0;
+    const void *data = LockResource(LoadResource(NULL, resource));
+    if (!data || !size) return 0;
+    HANDLE output = CreateFileW(file, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (output == INVALID_HANDLE_VALUE) return 0;
+    int ok = WriteFile(output, data, size, &written, NULL) && written == size;
+    CloseHandle(output);
+    return ok;
+}
+
+// Only called on the unique temporary folder this process created. Never traverse reparse points.
+static void clean_folder(const wchar_t *folder) {
+    wchar_t *pattern = calloc(PATH_CAP, sizeof *pattern);
+    wchar_t *child = calloc(PATH_CAP, sizeof *child);
+    if (!pattern || !child) goto done;
+    if (swprintf(pattern, PATH_CAP, L"%ls\\*", folder) < 0) goto done;
+    WIN32_FIND_DATAW entry;
+    HANDLE search = FindFirstFileW(pattern, &entry);
+    if (search != INVALID_HANDLE_VALUE) {
+        do {
+            if (!wcscmp(entry.cFileName, L".") || !wcscmp(entry.cFileName, L"..")) continue;
+            if (swprintf(child, PATH_CAP, L"%ls\\%ls", folder, entry.cFileName) < 0) continue;
+            if (entry.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
+                if (entry.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) RemoveDirectoryW(child);
+                else clean_folder(child);
+            } else DeleteFileW(child);
+        } while (FindNextFileW(search, &entry));
+        FindClose(search);
+    }
+    RemoveDirectoryW(folder);
+done:
+    free(pattern);
+    free(child);
+}
+
+int WINAPI wWinMain(HINSTANCE self, HINSTANCE previous, PWSTR line, int show) {
+    (void)self; (void)previous; (void)line; (void)show;
+    wchar_t *temp = calloc(PATH_CAP, sizeof *temp);
+    wchar_t *folder = calloc(PATH_CAP, sizeof *folder);
+    wchar_t *archive = calloc(PATH_CAP, sizeof *archive);
+    wchar_t *script = calloc(PATH_CAP, sizeof *script);
+    wchar_t *command = calloc(2 * PATH_CAP, sizeof *command);
+    wchar_t system[MAX_PATH], guid_text[40];
+    GUID guid;
+    int result = 2, made_folder = 0;
+    if (!temp || !folder || !archive || !script || !command) goto failure;
+    DWORD size = GetTempPathW(PATH_CAP, temp);
+    if (!size || size >= PATH_CAP || FAILED(CoCreateGuid(&guid)) || !StringFromGUID2(&guid, guid_text, 40)) goto failure;
+    if (swprintf(folder, PATH_CAP, L"%lsOcarinaKR-%ls", temp, guid_text) < 0 || !CreateDirectoryW(folder, NULL)) goto failure;
+    made_folder = 1;
+    if (swprintf(archive, PATH_CAP, L"%ls\\payload.zip", folder) < 0 ||
+        swprintf(script, PATH_CAP, L"%ls\\prepare.ps1", folder) < 0 ||
+        !write_resource(101, archive) || !write_resource(102, script)) goto failure;
+    SetEnvironmentVariableW(L"OCARINA_BUNDLE_ZIP", archive);
+    SetEnvironmentVariableW(L"OCARINA_BUNDLE_DIR", folder);
+    if (!GetSystemDirectoryW(system, MAX_PATH)) goto failure;
+    if (swprintf(command, 2 * PATH_CAP,
+        L"\"%ls\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -Sta -WindowStyle Hidden -ExecutionPolicy Bypass -File \"%ls\"",
+        system, script) < 0) goto failure;
+    STARTUPINFOW startup = {.cb = sizeof startup};
+    PROCESS_INFORMATION process;
+    if (!CreateProcessW(NULL, command, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, folder, &startup, &process)) goto failure;
+    CloseHandle(process.hThread);
+    WaitForSingleObject(process.hProcess, INFINITE);
+    DWORD code = 1;
+    GetExitCodeProcess(process.hProcess, &code);
+    CloseHandle(process.hProcess);
+    result = (int)code;
+    goto done;
+failure:
+#if defined(ANALYSIS_EXPORTER)
+    MessageBoxW(NULL, L"분석 도구를 준비하지 못했습니다. 임시 폴더의 여유 공간을 확인하고 다시 실행하세요.\n\nWindows 10/11 64비트와 Windows PowerShell이 필요합니다.",
+                L"Ocarina 분석 자료 내보내기", MB_OK | MB_ICONERROR);
+#else
+    MessageBoxW(NULL, L"설치 파일을 준비하지 못했습니다. 임시 폴더의 여유 공간을 확인하고 다시 실행하세요.\n\nWindows 10/11 64비트와 Windows PowerShell이 필요합니다.",
+                L"Ocarina Recomp 한국어 설치", MB_OK | MB_ICONERROR);
+#endif
+done:
+    if (made_folder) clean_folder(folder);
+    free(temp); free(folder); free(archive); free(script); free(command);
+    return result;
+}
diff --git a/jogar/collect-diagnostics.ps1 b/jogar/collect-diagnostics.ps1
new file mode 100644
index 0000000..1cea07e
--- /dev/null
+++ b/jogar/collect-diagnostics.ps1
@@ -0,0 +1,63 @@
+﻿# Collect hardware and bounded text logs only; never includes game files, shaders or saves.
+param([switch]$SemJanela, [string]$InstallRoot)
+$ErrorActionPreference = 'Stop'
+Add-Type -AssemblyName System.IO.Compression.FileSystem
+$root = if ($InstallRoot) { [IO.Path]::GetFullPath($InstallRoot) } else { Split-Path $PSScriptRoot -Parent }
+$directory = Join-Path $root 'diagnostics'
+New-Item -ItemType Directory -Path $directory -Force | Out-Null
+$stamp = (Get-Date -Format 'yyyyMMdd-HHmmss') + '-' + [Guid]::NewGuid().ToString('N').Substring(0, 6)
+$work = Join-Path $directory $stamp
+New-Item -ItemType Directory -Path $work | Out-Null
+$info = [ordered]@{ collected_at = (Get-Date -Format 'o'); package = '0.2.5-ko1'; measurements = 'See frame/pipeline lines in the logs; no benchmark is inferred from settings.' }
+try {
+    $info['cpu'] = @(Get-CimInstance Win32_Processor | Select-Object Name, NumberOfCores, NumberOfLogicalProcessors)
+    $info['gpu'] = @(Get-CimInstance Win32_VideoController | Select-Object Name, DriverVersion, VideoModeDescription)
+    $info['ram_gb'] = [Math]::Round((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory / 1GB, 1)
+} catch { $info['hardware_error'] = $_.Exception.Message }
+$exe = Join-Path $root 'build\oot111\ocarina.exe'
+if (Test-Path -LiteralPath $exe) {
+    try { $info['game_exe_sha256'] = (Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash }
+    catch { $info['exe_hash_error'] = $_.Exception.Message }
+}
+$ini = Join-Path $root 'build\oot111\totk.ini'
+if (Test-Path -LiteralPath $ini) {
+    $info['settings'] = @(Get-Content -LiteralPath $ini | Where-Object { $_ -match '^\s*(fps_limit|output_res|render_scale|oot_resolution|window_size|upscaler|vk_present|lang|menu_lang|operation_mode|vk_dyn_a2c|vk_dyn_vertex|sharpness|color_preset|color_brightness|color_contrast|color_saturation|color_gamma|fix_c0|fix_zero|astc|astc_bc|memory|tex_vram_pressure|lib_prebuild_threads)\s*=' })
+}
+$sources = @('ultima-partida.log', 'ultima-partida-erros.log')
+$history = Join-Path $root 'logs'
+if (Test-Path -LiteralPath $history) {
+    $recent = @(Get-ChildItem -LiteralPath $history -Filter 'partida-*-erros.log' -File | Sort-Object LastWriteTimeUtc -Descending | Select-Object -First 2)
+    foreach ($item in $recent) {
+        $sources += 'logs\' + $item.Name
+        $sources += 'logs\' + ($item.Name -replace '-erros\.log$', '.log')
+    }
+}
+foreach ($relative in $sources) {
+    $name = Split-Path $relative -Leaf
+    $path = Join-Path $root $relative
+    if (-not (Test-Path -LiteralPath $path)) { continue }
+    $stream = $null
+    try {
+        $stream = [IO.File]::Open($path, 'Open', 'Read', 'ReadWrite,Delete')
+        $count = [int][Math]::Min(2097152, $stream.Length)
+        [void]$stream.Seek(-$count, 'End')
+        $bytes = New-Object byte[] $count
+        $read = 0
+        while ($read -lt $count) { $n = $stream.Read($bytes, $read, $count - $read); if ($n -eq 0) { break }; $read += $n }
+        $copy = New-Object byte[] $read
+        [Array]::Copy($bytes, 0, $copy, 0, $read)
+        [IO.File]::WriteAllBytes((Join-Path $work $name), $copy)
+    } catch { $info[$name + '_error'] = $_.Exception.Message }
+    finally { if ($stream) { $stream.Dispose() } }
+}
+$info | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath (Join-Path $work 'system.json') -Encoding UTF8
+$translator = Join-Path $root 'build\xlate\totk_xlate.id'
+if (Test-Path -LiteralPath $translator) { Copy-Item -LiteralPath $translator -Destination $work }
+$zip = Join-Path $directory ('oot-diagnostics-' + $stamp + '.zip')
+[IO.Compression.ZipFile]::CreateFromDirectory($work, $zip)
+Remove-Item -LiteralPath $work -Recurse -Force
+Write-Output $zip
+if (-not $SemJanela) {
+    Add-Type -AssemblyName System.Windows.Forms
+    [void][Windows.Forms.MessageBox]::Show("진단 ZIP을 만들었습니다.`n`n$zip`n`n오카리나 연주 등 종료 직전 상황과 함께 이 파일을 첨부하세요. 게임 파일과 저장 데이터는 포함하지 않습니다.", 'Ocarina Recomp 진단', 'OK', 'Information')
+}
diff --git a/jogar/export-analysis.ps1 b/jogar/export-analysis.ps1
new file mode 100644
index 0000000..1320fac
--- /dev/null
+++ b/jogar/export-analysis.ps1
@@ -0,0 +1,93 @@
+﻿# Creates a private ZIP of owned executable modules + diagnostics. No upload, NUP, keys, RomFS or saves.
+param([string]$Exefs, [string]$Scene = '', [switch]$SemJanela, [string]$InstallRoot)
+$ErrorActionPreference = 'Stop'
+$toolRoot = Split-Path $PSScriptRoot -Parent
+$root = if ($InstallRoot) { [IO.Path]::GetFullPath($InstallRoot) } else { $toolRoot }
+$python = Join-Path $root 'ferramentas\python\python.exe'
+if (-not (Test-Path -LiteralPath $python)) { $python = Join-Path $root '.venv\Scripts\python.exe' }
+$backend = Join-Path $toolRoot 'tools\oot\export_analysis.py'
+if (-not $Exefs) { $Exefs = Join-Path $root 'build\exefs' }
+$progress = $null
+$process = $null
+if (-not $SemJanela) { Add-Type -AssemblyName System.Windows.Forms, System.Drawing }
+
+function Quote-ProcessArgument([string]$Value) {
+    # Windows CommandLineToArgvW/CRT rules; do not pass through cmd.exe.
+    $quoted = [regex]::Replace($Value, '(\\*)"', '$1$1\"')
+    $quoted = [regex]::Replace($quoted, '(\\+)$', '$1$1')
+    return '"' + $quoted + '"'
+}
+
+try {
+    if (-not (Test-Path -LiteralPath (Join-Path $Exefs 'main'))) {
+        if ($SemJanela) { throw '설치를 완료한 뒤 다시 실행하세요. build\exefs\main이 필요합니다.' }
+        $folder = New-Object Windows.Forms.FolderBrowserDialog
+        $folder.Description = '설치 폴더의 build\exefs를 선택하세요. main, sdk 등이 있는 폴더입니다.'
+        if ($folder.ShowDialog() -ne 'OK') { exit 0 }
+        $Exefs = $folder.SelectedPath
+    }
+    if (-not $SemJanela) {
+        $form = New-Object Windows.Forms.Form
+        $form.Text = 'Ocarina Recomp - 분석 자료 내보내기'
+        $form.ClientSize = New-Object Drawing.Size(650, 265)
+        $form.StartPosition = 'CenterScreen'; $form.FormBorderStyle = 'FixedDialog'; $form.MaximizeBox = $false
+        $form.Font = New-Object Drawing.Font('Malgun Gothic', 10)
+        $label = New-Object Windows.Forms.Label
+        $label.SetBounds(20, 15, 610, 84)
+        $label.Text = "본인 게임의 실행 코드와 진단 로그를 분석 ZIP으로 복사합니다.`n게임 리소스·세이브·NUP·키는 넣지 않으며 자동 전송하지 않습니다.`n아래에 화면이 이상하거나 깜빡이는 장소·상황을 적어 주세요."
+        $sceneBox = New-Object Windows.Forms.TextBox
+        $sceneBox.SetBounds(20, 108, 610, 85); $sceneBox.Multiline = $true; $sceneBox.Text = $Scene; $sceneBox.MaxLength = 10000
+        $ok = New-Object Windows.Forms.Button
+        $ok.SetBounds(390, 210, 120, 36); $ok.Text = '내보내기'; $ok.DialogResult = 'OK'
+        $cancel = New-Object Windows.Forms.Button
+        $cancel.SetBounds(520, 210, 110, 36); $cancel.Text = '취소'; $cancel.DialogResult = 'Cancel'
+        $form.Controls.AddRange(@($label, $sceneBox, $ok, $cancel))
+        if ($form.ShowDialog() -ne 'OK') { $form.Dispose(); exit 0 }
+        $Scene = $sceneBox.Text; $form.Dispose()
+        $progress = New-Object Windows.Forms.Form
+        $progress.Text = '분석 ZIP 준비 중'
+        $progress.ClientSize = New-Object Drawing.Size(500, 105)
+        $progress.StartPosition = 'CenterScreen'; $progress.ControlBox = $false
+        $status = New-Object Windows.Forms.Label
+        $status.SetBounds(18, 18, 465, 68)
+        $status.Text = "실행 코드와 로그를 복사·압축하고 있습니다.`n원본 파일은 변경하지 않습니다. 잠시 기다려 주세요."
+        $progress.Controls.Add($status); $progress.Show(); $progress.Refresh()
+    }
+    $diagnostic = & (Join-Path $PSScriptRoot 'collect-diagnostics.ps1') -SemJanela -InstallRoot $root
+    $arguments = @($backend, '--root', $root, '--exefs', $Exefs, '--diagnostic', $diagnostic, '--scene', $Scene)
+    $psi = New-Object Diagnostics.ProcessStartInfo
+    $psi.FileName = $python
+    $psi.Arguments = ($arguments | ForEach-Object { Quote-ProcessArgument ([string]$_) }) -join ' '
+    $psi.UseShellExecute = $false; $psi.CreateNoWindow = $true
+    $psi.RedirectStandardOutput = $true; $psi.RedirectStandardError = $true
+    $psi.StandardOutputEncoding = New-Object Text.UTF8Encoding($false)
+    $psi.StandardErrorEncoding = New-Object Text.UTF8Encoding($false)
+    $psi.EnvironmentVariables['PYTHONUTF8'] = '1'
+    $process = New-Object Diagnostics.Process
+    $process.StartInfo = $psi
+    [void]$process.Start()
+    $stdout = $process.StandardOutput.ReadToEndAsync()
+    $stderr = $process.StandardError.ReadToEndAsync()
+    while (-not $process.HasExited) {
+        if (-not $SemJanela) { [Windows.Forms.Application]::DoEvents() }
+        [Threading.Thread]::Sleep(50)
+    }
+    $process.WaitForExit()
+    $text = $stdout.GetAwaiter().GetResult()
+    $errorText = $stderr.GetAwaiter().GetResult()
+    if (-not $text.Trim()) { throw $errorText }
+    $result = $text | ConvertFrom-Json
+    if ($process.ExitCode -ne 0) { throw $result.error }
+    if ($progress) { $progress.Close() }
+    Write-Output $result.zip
+    if (-not $SemJanela) {
+        [void][Windows.Forms.MessageBox]::Show("분석 ZIP을 만들었습니다.`n`n$($result.zip)`n`n게임 실행 코드가 포함되어 있습니다. GitHub에 올리지 말고 이 채팅에 첨부하세요.", 'Ocarina Recomp', 'OK', 'Information')
+    }
+} catch {
+    if ($SemJanela) { throw }
+    [void][Windows.Forms.MessageBox]::Show($_.Exception.Message, '분석 자료 내보내기 실패', 'OK', 'Error')
+    exit 1
+} finally {
+    if ($process) { $process.Dispose() }
+    if ($progress) { $progress.Dispose() }
+}
