+#!/usr/bin/env python3
+"""Private analysis export tests use authored bytes, never real game files."""
+import hashlib
+import json
+from pathlib import Path
+import tempfile
+import unittest
+import zipfile
+
+from export_analysis import export
+
+
+class ExportTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name) / '설치 [폴더]'
+        self.exefs = self.root / 'build/exefs'
+        self.exefs.mkdir(parents=True)
+        (self.exefs / 'main').write_bytes(b'NSO0-authored test fixture')
+        (self.exefs / 'sdk').write_bytes(b'authored SDK fixture')
+
+    def test_whitelist_hashes_and_source_preservation(self):
+        for name in ('prod.keys', 'game.nup', 'account.sav'):
+            (self.exefs / name).write_bytes(b'not selected')
+        original = {p.name: p.read_bytes() for p in self.exefs.iterdir()}
+        result = export(self.root, scene='마을에서 화면이 번쩍임')
+        with zipfile.ZipFile(result['zip']) as archive:
+            self.assertEqual(set(archive.namelist()), {'exefs/main', 'exefs/sdk', 'analysis.json'})
+            info = json.loads(archive.read('analysis.json'))
+            self.assertFalse(info['matches_ocarina_111'])
+            self.assertEqual(info['scene'], '마을에서 화면이 번쩍임')
+            for row in info['files']:
+                self.assertEqual(hashlib.sha256(archive.read(row['name'])).hexdigest(), row['sha256'])
+        self.assertEqual({p.name: p.read_bytes() for p in self.exefs.iterdir()}, original)
+
+    def test_diagnostics_included_unchanged(self):
+        diagnostic = self.root / 'diagnostic.zip'
+        with zipfile.ZipFile(diagnostic, 'w') as archive:
+            archive.writestr('system.json', '{}')
+        result = export(self.root, diagnostic=diagnostic)
+        with zipfile.ZipFile(result['zip']) as archive:
+            self.assertEqual(archive.read('diagnostics.zip'), diagnostic.read_bytes())
+
+    def test_invalid_input_and_existing_output_preserved(self):
+        output = self.root / 'existing.zip'
+        output.write_bytes(b'user data')
+        with self.assertRaises(ValueError):
+            export(self.root, output=output)
+        self.assertEqual(output.read_bytes(), b'user data')
+        (self.exefs / 'main').write_bytes(b'not a prepared NSO')
+        with self.assertRaises(ValueError):
+            export(self.root)
+
+    def test_source_folder_is_never_written(self):
+        with self.assertRaises(ValueError):
+            export(self.root, output=self.exefs / 'analysis.zip')
+        self.assertFalse((self.exefs / 'analysis.zip').exists())
+
+    def test_linked_modules_and_corrupt_diagnostics_refused(self):
+        (self.exefs / 'rtld').symlink_to(self.exefs / 'sdk')
+        with self.assertRaises(ValueError):
+            export(self.root)
+        (self.exefs / 'rtld').unlink()
+        bad = self.root / 'bad.zip'
+        bad.write_bytes(b'not a zip')
+        with self.assertRaises(zipfile.BadZipFile):
+            export(self.root, diagnostic=bad)
+        self.assertFalse((self.root / 'diagnostics').exists())
+
+    def test_alternate_exefs_root(self):
+        other = self.root / '선택한 exefs'
+        other.mkdir()
+        (other / 'main').write_bytes(b'NSO0-another authored fixture')
+        result = export(self.root, exefs=other)
+        with zipfile.ZipFile(result['zip']) as archive:
+            self.assertEqual(archive.read('exefs/main'), (other / 'main').read_bytes())
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
