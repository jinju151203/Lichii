+    $destination = Join-Path $env:OCARINA_BUNDLE_DIR 'unpacked'
+    [IO.Compression.ZipFile]::ExtractToDirectory($env:OCARINA_BUNDLE_ZIP, $destination)
+    $kit = Join-Path $destination 'Ocarina-Analysis-Export'
+    $dialog = New-Object Windows.Forms.FolderBrowserDialog
+    $dialog.Description = '기존 OcarinaRecomp 설치 폴더를 선택하세요. 게임을 다시 설치하거나 컴파일하지 않습니다.'
+    if (Test-Path -LiteralPath 'C:\OcarinaRecomp') { $dialog.SelectedPath = 'C:\OcarinaRecomp' }
+    if ($dialog.ShowDialog() -ne 'OK') { exit 0 }
+    & (Join-Path $kit 'jogar\export-analysis.ps1') -InstallRoot $dialog.SelectedPath
+} catch {
