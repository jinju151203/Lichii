@@ -0,0 +1,155 @@
+#!/usr/bin/env python3
+"""Save migration regressions with authored data only; no game saves are bundled."""
+import hashlib
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+import import_save as saves
+
+
+def put(root, name, content=b'authored fixture'):
+    path = root / name
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(content)
+    return path
+
+
+def tree(root):
+    return {p.relative_to(root).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest() for p in root.rglob('*') if p.is_file()}
+
+
+class SaveTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.src = self.root / '리치 [저장]'
+        put(self.src, 'account.sav')
+        put(self.src, 'slot_00/data.sav', b'new progress')
+        put(self.src, 'slot_00/caption.sav', b'authored thumbnail placeholder')
+        self.profile = self.root / '포트 프로필'
+        self.uid = bytes(range(16))
+        put(self.profile, 'account.uid', self.uid)
+        self.dst = self.profile / 'save' / self.uid[::-1].hex()
+        put(self.dst, 'account.sav', b'old account')
+        put(self.dst, 'old_slot_only', b'old progress')
+        put(self.profile, 'save-tx/ready-4/account.sav', b'pending commit')
+        put(self.profile, 'save-tx/work/test', b'uncommitted change')
+
+    def test_import_matches_native_uid_and_keeps_both_backups(self):
+        original = tree(self.src)
+        old = tree(self.dst)
+        tx = tree(self.profile / 'save-tx')
+        result = saves.import_save(self.src, self.profile)
+        backup = Path(result['backup'])
+        self.assertEqual(tree(self.dst), original)
+        self.assertEqual(tree(backup / 'save'), old)
+        self.assertEqual(tree(backup / 'save-tx'), tx)
+        self.assertFalse((self.profile / 'save-tx').exists())
+        self.assertEqual(tree(self.src), original)
+        self.assertEqual((self.profile / 'account.uid').read_bytes(), self.uid)
+        self.assertEqual(result['sha256'], original)
+
+    def test_new_profile_creates_real_16_byte_account(self):
+        profile = self.root / 'fresh'
+        result = saves.import_save(self.src, profile)
+        uid = (profile / 'account.uid').read_bytes()
+        self.assertEqual(len(uid), 16)
+        self.assertEqual(Path(result['destination']), profile / 'save' / uid[::-1].hex())
+        self.assertEqual(tree(Path(result['destination'])), tree(self.src))
+
+    def test_discovery_legacy_new_layout_portable_and_separate_accounts(self):
+        roaming = self.root / 'AppData'
+        a = roaming / 'eden/nand/user/save/0000000000000000' / ('A' * 32) / saves.TITLE
+        b = roaming / 'eden/nand/user/save/account' / ('B' * 32) / saves.TITLE / '0'
+        portable = self.root / 'portable/user/nand/user/save/0' / ('C' * 32) / saves.TITLE
+        other = roaming / 'eden/nand/user/save/0' / ('D' * 32) / '0100000000000000'
+        for root in (a, b, portable, other):
+            put(root, 'account.sav')
+        found = saves.discover([self.root / 'portable'], roaming)
+        self.assertEqual({p['path'] for p in found}, {str(p) for p in (a, b, portable)})
+        self.assertEqual({p['account'] for p in found}, {'A' * 32, 'B' * 32, 'C' * 32})
+
+    def test_direct_folder_and_file_style_slot(self):
+        direct = self.root / 'direct'
+        put(direct, 'slot_00', b'authored file slot')
+        self.assertTrue(saves.is_save(direct))
+        self.assertEqual(saves.discover([direct])[0]['path'], str(direct))
+
+    def test_bad_uid_and_empty_save_do_not_touch_existing(self):
+        before = tree(self.profile)
+        empty = self.root / 'empty'
+        put(empty, 'account.sav', b'')
+        with self.assertRaises(ValueError):
+            saves.import_save(empty, self.profile)
+        self.assertEqual(tree(self.profile), before)
+        (self.profile / 'account.uid').write_bytes(b'bad')
+        before = tree(self.profile)
+        with self.assertRaises(ValueError):
+            saves.import_save(self.src, self.profile)
+        self.assertEqual(tree(self.profile), before)
+
+    def test_source_inside_profile_is_rejected(self):
+        before = tree(self.profile)
+        with self.assertRaises(ValueError):
+            saves.import_save(self.dst, self.profile)
+        self.assertEqual(tree(self.profile), before)
+
+    def test_copy_error_leaves_existing_and_pending_commit_untouched(self):
+        before = tree(self.profile)
+        with patch.object(saves.hashlib, 'file_digest', side_effect=OSError('test read failure')):
+            with self.assertRaises(OSError):
+                saves.import_save(self.src, self.profile)
+        self.assertEqual(tree(self.profile), before)
+
+    def test_failed_commit_rolls_back_old_save_and_pending_commit(self):
+        old, tx = tree(self.dst), tree(self.profile / 'save-tx')
+        real = saves.os.replace
+        def fail(source, target):
+            if Path(source).name == 'save' and '.save-import-' in str(source):
+                raise OSError('test locked destination')
+            return real(source, target)
+        with patch.object(saves.os, 'replace', side_effect=fail):
+            with self.assertRaises(OSError):
+                saves.import_save(self.src, self.profile)
+        self.assertEqual(tree(self.dst), old)
+        self.assertEqual(tree(self.profile / 'save-tx'), tx)
+        self.assertEqual((self.profile / 'account.uid').read_bytes(), self.uid)
+
+    def test_new_uid_removed_after_failed_commit(self):
+        profile = self.root / 'fresh-failed'
+        with patch.object(saves.os, 'replace', side_effect=OSError('test failure')):
+            with self.assertRaises(OSError):
+                saves.import_save(self.src, profile)
+        self.assertFalse((profile / 'account.uid').exists())
+
+    def test_repeated_imports_keep_unique_backups(self):
+        first = saves.import_save(self.src, self.profile)
+        second = saves.import_save(self.src, self.profile)
+        self.assertNotEqual(first['backup'], second['backup'])
+        self.assertTrue(Path(first['backup']).is_dir())
+
+    def test_original_changing_during_copy_is_rejected(self):
+        before = tree(self.profile)
+        real = saves.hashlib.file_digest
+        def changed(*args):
+            result = real(*args)
+            put(self.src, 'new_file', b'concurrent change')
+            return result
+        with patch.object(saves.hashlib, 'file_digest', side_effect=changed):
+            with self.assertRaises(ValueError):
+                saves.import_save(self.src, self.profile)
+        self.assertEqual(tree(self.profile), before)
+
+    def test_links_are_refused_before_destination_changes(self):
+        before = tree(self.profile)
+        (self.src / 'linked').symlink_to(self.profile, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            saves.import_save(self.src, self.profile)
+        self.assertEqual(tree(self.profile), before)
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
