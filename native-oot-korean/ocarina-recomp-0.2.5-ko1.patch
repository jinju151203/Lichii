new file mode 100644
index 0000000..4eb0523
--- /dev/null
+++ b/tools/oot/set_korean.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Select game/menu Korean without resetting unrelated settings or touching game data."""
+from __future__ import annotations
+
+import argparse
+import os
+from pathlib import Path
+import re
+import tempfile
+
+
+def korean_config(data: bytes) -> bytes:
+    bom = b"\xef\xbb\xbf" if data.startswith(b"\xef\xbb\xbf") else b""
+    text = data[len(bom):].decode("utf-8")
+    newline = "\r\n" if "\r\n" in text else "\n"
+    seen: set[str] = set()
+    out: list[str] = []
+    # cfg.c accepts prefixed keys, any case, in any section; the last duplicate wins.
+    key_re = re.compile(r"^([ \t]*(?:TOTK_)?(LANG|MENU_LANG)[ \t]*=[ \t]*)([^\r\n]*)(\r?\n)?$", re.I)
+    for line in text.splitlines(keepends=True):
+        match = key_re.match(line)
+        if match:
+            seen.add(match[2].upper())
+            if match[3].strip().strip('"') != "ko":
+                line = match[1] + "ko" + (match[4] or "")
+        out.append(line)
+    result = "".join(out)
+    missing = [key for key in ("LANG", "MENU_LANG") if key not in seen]
+    if missing:
+        if result and not result.endswith("\n"):
+            result += newline
+        result += newline + "[language]" + newline
+        result += "".join(key.lower() + " = ko" + newline for key in missing)
+    return bom + result.encode("utf-8")
+
+
+def apply(path: Path) -> Path | None:
+    existed = path.exists()
+    original = path.read_bytes() if existed else b""
+    updated = korean_config(original)
+    if updated == original:
+        return None
+    path.parent.mkdir(parents=True, exist_ok=True)
+    backup = None
+    if existed:
+        # Never overwrite an earlier backup, including after the user changes languages again.
+        for number in range(10000):
+            suffix = "" if number == 0 else f".{number}"
+            candidate = path.with_name(path.name + ".before-korean" + suffix + ".bak")
+            try:
+                with candidate.open("xb") as stream:
+                    stream.write(original)
+                backup = candidate
+                break
+            except FileExistsError:
+                continue
+        else:
+            raise OSError("No free backup name; settings were not changed")
+    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
+    try:
+        with os.fdopen(fd, "wb") as stream:
+            stream.write(updated)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+    return backup
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("ini", type=Path)
+    args = parser.parse_args()
+    backup = apply(args.ini)
+    print(f"Korean game/menu selected: {args.ini}")
+    if backup:
+        print(f"Previous settings: {backup}")
+    overrides = [key for key in ("TOTK_LANG", "TOTK_MENU_LANG") if os.environ.get(key)]
+    if overrides:
+        print("Environment overrides still take priority: " + ", ".join(overrides))
+
+
+if __name__ == "__main__":
+    main()
