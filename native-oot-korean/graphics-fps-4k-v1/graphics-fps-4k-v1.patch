@@ -0,0 +1,33 @@
+// Ocarina's existing authored fixed-resolution hook uses a fraction of its output.
+// Derive that fraction from the actual presented NVN texture, never the desktop/window size.
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include "oot_render_policy.h"
+extern const int rt_oot_clock; // installer-owned modules.c; 1 only with the authored game-clock hook
+extern void rt_log(const char *, ...);
+static _Atomic uint64_t output_size;
+static _Atomic int scene_4k_seen;
+
+int oot_realtime_clock(void) {
+    const char *off = getenv("OOT_DYN_DT");
+    return rt_oot_clock && !(off && *off == '0');
+}
+
+void oot_note_output(uint32_t width, uint32_t height) {
+    if (!rt_oot_clock || !width || !height) return;
+    atomic_store_explicit(&output_size, (uint64_t)width << 32 | height, memory_order_relaxed);
+}
+
+float oot_internal_4k_scale(void) {
+    uint64_t size = atomic_load_explicit(&output_size, memory_order_relaxed);
+    uint32_t w = (uint32_t)(size >> 32), h = (uint32_t)size;
+    // Do not enter the fixed path before a real, supported output has been observed.
+    if (w < 960 || w > 7680 || h < 540 || h > 4320 || (uint64_t)w * 9 != (uint64_t)h * 16) return 0;
+    return 3840.0f / (float)w;
+}
+
+void oot_note_scene(uint32_t width, uint32_t height) {
+    if (rt_oot_clock && width == 3840 && height == 2160 && !atomic_exchange(&scene_4k_seen, 1))
+        rt_log("resolution: observed 3840x2160 color/depth render pass (internal 4K target)");
+}
